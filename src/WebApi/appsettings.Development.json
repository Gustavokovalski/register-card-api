{
  "Logging": {
    "Console": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning"
      },
      "FormatterName": "simple"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:8080"
      }
    }
  },
  "OpenTelemetryConfiguration": {
    "MetricsDebug": false,
    "LogDebug": false,
    "TraceDebug": false
  }
}
